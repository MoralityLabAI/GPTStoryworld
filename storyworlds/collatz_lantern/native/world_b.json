    {
      "id": "page_amber",
      "title": "An amber lamp",
      "text_script": {
        "pointer_type": "String Constant",
        "script_element_type": "Pointer",
        "value": "The sample shutter opens onto amber glass. You have spent one eighth of a ration. The next odd state is one modulo four. Starting from one produces sixteen before the factors of two are removed, leaving one. Starting from five produces twenty-eight, leaving seven, which would light the blue lamp. Mara rests the ledger beside the handles. \"You can use the new reading now.\""
      },
